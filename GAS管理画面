/**
 * 供給メールレーダー 管理画面（サーバー側） v1.3（医薬品一覧アップロード追加）
 * 供給メールレーダー.gs と同じプロジェクトに、別ファイルとして追加する
 *
 * 機能：採用薬の件数・一覧・個別追加（医薬品一覧から検索して追加も可）／削除・
 *       採用薬一括アップロード（置換／追加）・一括ダウンロード・更新履歴・バックアップからのロールバック（初期3世代）
 *       医薬品一覧アップロード（厚労省「薬価基準収載品目リスト」tpYYYYMMDD-01_01〜_04.xlsx の取り込み）
 *
 * 追加シート（自動作成）
 *   採用薬_履歴          : 更新履歴（医薬品一覧の取り込みも記録）
 *   採用薬_bk_yyyyMMdd_HHmmss : 更新直前の採用薬シートのコピー（非表示）
 *   医薬品一覧_bk        : 取り込み直前の医薬品一覧のコピー（非表示・1世代）
 *
 * スクリプトプロパティ
 *   ADMIN_PW           : 管理画面のパスワード（必須。未設定だと誰もログインできない）
 *   BACKUP_GENERATIONS : 残すバックアップの世代数（任意・初期値 3）
 *   ADMIN_TOKEN_SALT   : ログイン用の内部キー（自動作成・触らない）
 *   MASTER_INFO        : 医薬品一覧の最終取り込み情報（自動作成・触らない）
 */

// ===== 定数 =====
const SHEET_ADOPTED_HISTORY = '採用薬_履歴';
const BACKUP_PREFIX = '採用薬_bk_';
const ADOPTED_HEADER = ['YJコード', '薬品名', '規格', 'メモ'];
const MASTER_BACKUP = '医薬品一覧_bk';
// 医薬品一覧シートの見出し（取り込み後はこの並びで書き直す。本体は見出し名で列を探すので順番は自由）
const MASTER_HEADER = ['区分', '薬価基準収載医薬品コード', '成分名', '規格', '品名', 'メーカー名',
  '診療報酬において加算等の算定対象となる後発医薬品', '先発医薬品', '同一剤形・規格の後発医薬品がある先発医薬品',
  '薬価', '経過措置による使用期限', '備考', '収載リスト'];
const KUBUN_ORDER = ['内用薬', '注射薬', '外用薬', '歯科用薬剤'];

