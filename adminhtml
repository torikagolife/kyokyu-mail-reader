// ---------- 医薬品一覧アップロード ----------
const MST_KIND = { '01': '内用薬', '02': '注射薬', '03': '外用薬', '04': '歯科用薬剤' };
let MST = [];
function hnorm(s) { return String(s == null ? '' : s).normalize('NFKC').replace(/\s/g, ''); }
function readMasterFiles() {
  const files = Array.from(document.getElementById('mstFile').files);
  document.getElementById('mstResult').innerHTML = '';
  MST = [];
  if (!files.length) { document.getElementById('mstArea').style.display = 'none'; return; }
  if (typeof XLSX === 'undefined') { toast('Excelの読み込み部品が使えません。ネットワークを確認してください', true); return; }
  busy(true);
  Promise.all(files.map(f => new Promise(res => {
    const fr = new FileReader();
    fr.onload = () => res(parseMasterFile(f.name, new Uint8Array(fr.result)));
    fr.onerror = () => res({ name: f.name, error: '読み込めませんでした' });
    fr.readAsArrayBuffer(f);
  }))).then(list => {
    busy(false);
    MST = list;
    renderMasterFiles();
  });
}
function parseMasterFile(name, bytes) {
  const m = name.match(/_(0\d)\.xlsx?$/i);
  const no = m ? m[1] : '';
  if (no === '05' || no === '06') return { name, error: 'このファイル（_' + no + '）は形式が違うので使いません' };
  try {
    const wb = XLSX.read(bytes, { type: 'array' });
    for (const sn of wb.SheetNames) {
      const rows = XLSX.utils.sheet_to_json(wb.Sheets[sn], { header: 1, raw: false, defval: '' });
      const hi = rows.slice(0, 20).findIndex(r => r.some(c => hnorm(c) === '薬価基準収載医薬品コード'));
      if (hi < 0) continue;
      const h = rows[hi].map(hnorm);
      const exact = t => h.indexOf(t);
      const has = (...ts) => h.findIndex(x => ts.every(t => x.indexOf(t) >= 0));
      const col = [
        exact('区分'), exact('薬価基準収載医薬品コード'), exact('成分名'), exact('規格'), exact('品名'), exact('メーカー名'),
        has('後発医薬品', '算定対象'), exact('先発医薬品'), has('同一剤形', '先発医薬品'), exact('薬価'), has('経過措置'), exact('備考')
      ];
      if (col[1] < 0 || col[4] < 0) continue;
      const out = [];
      for (let i = hi + 1; i < rows.length; i++) {
        const r = rows[i];
        const code = hnorm(r[col[1]]).toUpperCase();
        if (!YJ.test(code)) continue;
        out.push(col.map(j => j < 0 ? '' : String(r[j] == null ? '' : r[j]).trim()));
      }
      const kubun = out.length ? out[0][0] : '';
      return { name, no, kind: MST_KIND[no] || kubun || '不明', rows: out, missing: [col[2], col[3], col[5], col[9]].some(j => j < 0) };
    }
    return { name, error: '「薬価基準収載医薬品コード」の見出しが見つかりません' };
  } catch (e) { return { name, error: '読み込めませんでした：' + e.message }; }
}
function renderMasterFiles() {
  document.getElementById('mstArea').style.display = '';
  document.getElementById('mstFiles').innerHTML = MST.map(f =>
    '<tr><td class="mono" style="font-size:12px">' + esc(f.name) + '</td><td>' + esc(f.kind || '—') + '</td><td>' +
    (f.rows ? f.rows.length.toLocaleString() + ' 件' : '—') + '</td><td>' +
    (f.error ? '<span class="chip none">❌ ' + esc(f.error) + '</span>' :
      (f.rows.length ? '<span class="chip exact">✅ OK</span>' + (f.missing ? ' <span class="chip near">一部の列なし</span>' : '') : '<span class="chip none">品目がありません</span>')) +
    '</td></tr>').join('');
  const ok = MST.filter(f => f.rows && f.rows.length);
  const have = new Set(ok.map(f => f.no));
  const lack = ['01', '02', '03'].filter(n => !have.has(n)).map(n => MST_KIND[n]);
  const dup = ok.map(f => f.no).filter((n, i, a) => n && a.indexOf(n) !== i);
  const total = ok.reduce((a, f) => a + f.rows.length, 0);
  document.getElementById('mstWarn').innerHTML =
    '合計 <b>' + total.toLocaleString() + '</b> 件' +
    (lack.length ? '<br>⚠️ ' + lack.join('・') + ' のファイルがありません（「追記・更新」なら、その区分は今の一覧のまま残ります）' : '') +
    (dup.length ? '<br>⚠️ 同じ種類のファイルが2つ以上あります。新しい日付のものだけを選ぶのがおすすめです' : '');
  document.getElementById('mstBtn').disabled = !ok.length;
}
function uploadMaster() {
  const ok = MST.filter(f => f.rows && f.rows.length);
  if (!ok.length) return;
  const mode = document.querySelector('input[name=mstMode]:checked').value;
  const total = ok.reduce((a, f) => a + f.rows.length, 0);
  const msg = (mode === 'replace' ? '今の医薬品一覧を消して、' : '今の医薬品一覧に、') + total.toLocaleString() + ' 件を取り込みます。よろしいですか？';
  if (!confirm(msg)) return;
  call('admUploadMaster', { files: ok.map(f => ({ name: f.name, kind: f.kind, rows: f.rows })), mode }).then(st => {
    const r = st.masterResult;
    document.getElementById('mstResult').innerHTML = '<div class="note">🎉 医薬品一覧を取り込みました：全 <b>' + r.total.toLocaleString() + '</b> 件<br>' +
      '🆕 追加 ' + r.added.toLocaleString() + ' 件　🔁 更新 ' + r.updated.toLocaleString() + ' 件　' +
      (r.mode === 'merge' ? '📦 以前の品目を保持 ' + r.kept.toLocaleString() + ' 件' : '🧹 削除 ' + r.removed.toLocaleString() + ' 件') + '</div>';
    document.getElementById('mstFile').value = ''; document.getElementById('mstArea').style.display = 'none'; MST = [];
    apply(st);
  });
}
function restoreMaster() {
