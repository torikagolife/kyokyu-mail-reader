let lastLookup = '';
function lookup(force) {
  const code = norm(document.getElementById('aCode').value);
  document.getElementById('aCode').value = code;
  const out = document.getElementById('aLookup');
  if (!code) { out.textContent = ''; return; }
  if (!YJ.test(code)) { out.textContent = '⚠️ 12桁のYJコードを入れてください'; return; }
  if (!force && code === lastLookup) return;
  lastLookup = code;
  if (S && S.list.some(r => r.code === code)) { out.textContent = '⚠️ このコードはすでに登録されています'; return; }
  call('admLookup', code).then(r => {
    if (!r.ok) { out.textContent = '🤔 ' + r.message; return; }
    const n = document.getElementById('aName'), s = document.getElementById('aSpec');
    if (force || !n.value) n.value = r.name;
    if (force || !s.value) s.value = r.spec;
    out.textContent = r.exact ? '✅ 医薬品一覧から入力しました' + (r.maker ? '（' + r.maker + '）' : '') : '🔍 同規格の他銘柄の情報を入れました。薬品名を確認してください';
  });
}
function addOne() {
  const rec = { code: norm(document.getElementById('aCode').value), name: document.getElementById('aName').value,
    spec: document.getElementById('aSpec').value, memo: document.getElementById('aMemo').value };
  if (!YJ.test(rec.code)) return toast('12桁のYJコードを入れてください', true);
  if (!rec.name.trim()) return toast('薬品名を入れてください', true);
  call('admAdd', rec).then(st => {
    ['aCode', 'aName', 'aSpec', 'aMemo'].forEach(id => document.getElementById(id).value = '');
