function renderMasterInfo() {
  const mi = S.masterInfo || {};
  document.getElementById('mstInfo').textContent = '（' + (mi.count || 0).toLocaleString() + '件' +
    (mi.info ? '・最終取り込み ' + mi.info.at : '') + '）';
  document.getElementById('mstRestore').innerHTML = mi.hasBackup ?
    '<div class="row" style="margin-top:8px"><button class="btn ghost sm" onclick="restoreMaster()">⏪ 前回の取り込みの前に戻す</button>' +
    '<span class="hint">取り込み直前の医薬品一覧を1世代だけ残しています</span></div>' : '';
}

// ---------- 採用薬一括アップロード ----------
function readFile() {
  const f = document.getElementById('upFile').files[0];
  document.getElementById('upResult').innerHTML = '';
  if (!f) return;
  UP.name = f.name;
  const isXls = /\.xlsx?$/i.test(f.name);
  const fr = new FileReader();
  fr.onload = () => {
    try {
      if (isXls) {
        if (typeof XLSX === 'undefined') throw new Error('Excelの読み込み部品が使えません。CSVで保存してアップロードしてください');
        const wb = XLSX.read(new Uint8Array(fr.result), { type: 'array' });
        UP.sheets = {};
        wb.SheetNames.forEach(n => UP.sheets[n] = XLSX.utils.sheet_to_json(wb.Sheets[n], { header: 1, raw: false, defval: '' }));
        const sel = document.getElementById('upSheet');
        sel.innerHTML = wb.SheetNames.map(n => '<option>' + esc(n) + '</option>').join('');
        document.getElementById('sheetPick').style.display = wb.SheetNames.length > 1 ? '' : 'none';
        UP.rows = UP.sheets[wb.SheetNames[0]];
      } else {
        UP.sheets = null;
        document.getElementById('sheetPick').style.display = 'none';
        UP.rows = parseCsv(decode(new Uint8Array(fr.result)));
      }
      setupCols(); renderPreview();
      document.getElementById('upArea').style.display = '';
    } catch (e) { toast(e.message, true); }
  };
  fr.readAsArrayBuffer(f);
}
function pickSheet() { UP.rows = UP.sheets[document.getElementById('upSheet').value]; setupCols(); renderPreview(); }
function decode(bytes) {
  const enc = document.getElementById('upEnc').value;
  if (enc === 'shift_jis') return new TextDecoder('shift_jis').decode(bytes);
  if (enc === 'utf-8') return new TextDecoder('utf-8').decode(bytes);
  try { return new TextDecoder('utf-8', { fatal: true }).decode(bytes); }
  catch (e) { return new TextDecoder('shift_jis').decode(bytes); }
}
function parseCsv(text) {
  text = text.replace(/^﻿/, '');
  const rows = []; let row = [], cell = '', q = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (q) {
      if (c === '"') { if (text[i + 1] === '"') { cell += '"'; i++; } else q = false; }
      else cell += c;
    } else if (c === '"') q = true;
    else if (c === ',') { row.push(cell); cell = ''; }
    else if (c === '\n' || c === '\r') {
      if (c === '\r' && text[i + 1] === '\n') i++;
      row.push(cell); rows.push(row); row = []; cell = '';
    } else cell += c;
  }
  if (cell !== '' || row.length) { row.push(cell); rows.push(row); }
  return rows.filter(r => r.some(x => String(x).trim() !== ''));
}
function setupCols() {
  const width = Math.max(1, ...UP.rows.slice(0, 50).map(r => r.length));
  const head = UP.rows[0] || [];
  const opts = none => (none ? '<option value="-1">（なし）</option>' : '') +
    Array.from({ length: width }, (_, i) => '<option value="' + i + '">' + colName(i) + '列' + (head[i] ? '：' + esc(String(head[i]).slice(0, 12)) : '') + '</option>').join('');
  const find = (re, d) => { const i = head.findIndex(h => re.test(String(h))); return i >= 0 ? i : d; };
  const set = (id, none, v) => { const s = document.getElementById(id); s.innerHTML = opts(none); s.value = String(Math.min(v, width - 1)); };
  set('cCode', false, 0);                         // 既定：A列
  set('cName', false, Math.min(1, width - 1));    // 既定：B列
  set('cSpec', true, find(/規格/, -1));
  set('cMemo', true, find(/メモ|備考/, -1));
}
function selectedItems() {
  const start = document.getElementById('upHeader').checked ? 1 : 0;
  const ci = id => Number(document.getElementById(id).value);
  const [a, b, c, d] = ['cCode', 'cName', 'cSpec', 'cMemo'].map(ci);
  const g = (r, i) => i < 0 ? '' : String(r[i] == null ? '' : r[i]).trim();
  return UP.rows.slice(start).map(r => ({ code: norm(g(r, a)), name: g(r, b), spec: g(r, c), memo: g(r, d) }));
}
function renderPreview() {
  if (!UP.rows.length) return;
  const items = selectedItems();
  const valid = new Set(), dup = [], bad = [];
  items.forEach((it, i) => { if (!YJ.test(it.code)) { if (it.code) bad.push(i); } else if (valid.has(it.code)) dup.push(i); else valid.add(it.code); });
  const empty = items.filter(it => !it.code).length;
  document.getElementById('upStat').innerHTML =
    '✅ 有効 <b>' + valid.size + '</b> 件　' + (bad.length ? '❌ 形式エラー ' + bad.length + ' 件　' : '') +
    (dup.length ? '👯 重複 ' + dup.length + ' 件　' : '') + (empty ? '（空欄 ' + empty + ' 行は無視）' : '') +
    (S ? '<br>今の採用薬 ' + S.count + ' 件 → 置換すると ' + valid.size + ' 件' : '');
  const picks = ['cCode', 'cName', 'cSpec', 'cMemo'].map(id => Number(document.getElementById(id).value));
  const width = Math.max(1, ...UP.rows.slice(0, 50).map(r => r.length));
  const head = '<tr>' + Array.from({ length: width }, (_, i) => '<th>' + colName(i) + '</th>').join('') + '</tr>';
  document.getElementById('upPrev').innerHTML = head + UP.rows.slice(0, 8).map((r, ri) =>
    '<tr>' + Array.from({ length: width }, (_, i) => '<td class="' + (picks.includes(i) ? 'pick' : '') + '"' +
      (ri === 0 && document.getElementById('upHeader').checked ? ' style="font-weight:700"' : '') + '>' + esc(r[i]) + '</td>').join('') + '</tr>').join('');
  document.getElementById('upBtn').disabled = !valid.size;
}
function upload() {
  const mode = document.querySelector('input[name=upMode]:checked').value;
  const items = selectedItems().filter(it => it.code);
  const msg = mode === 'replace' ? '今の採用薬（' + S.count + '件）をすべて入れ替えます。よろしいですか？' : '採用薬に追加します。よろしいですか？';
  if (!confirm(msg)) return;
  call('admUpload', items, mode, UP.name).then(st => {
    const r = st.uploadResult;
    document.getElementById('upResult').innerHTML = '<div class="note">🎉 ' + esc(st.message) +
      (r.invalidCount ? '<br>❌ 形式エラーで除外した行（データ行の番号）：' + r.invalidRows.join(', ') + (r.invalidCount > r.invalidRows.length ? ' ほか' : '') : '') +
      (r.dupInFile ? '<br>👯 ファイル内の重複 ' + r.dupInFile + ' 件は1件にまとめました' : '') +
      (r.skippedExisting ? '<br>⏭️ 登録済みの ' + r.skippedExisting + ' 件はスキップしました' : '') + '</div>';
    document.getElementById('upFile').value = ''; document.getElementById('upArea').style.display = 'none'; UP.rows = [];
    apply(st);
  });
}

// ---------- 一括ダウンロード ----------
function csvText() {
  const q = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
  return '﻿' + [['YJコード', '薬品名', '規格', 'メモ']].concat(S.list.map(r => [r.code, r.name, r.spec, r.memo]))
    .map(r => r.map(q).join(',')).join('\r\n');
}
function fileStamp() { const d = new Date(); const p = n => String(n).padStart(2, '0'); return d.getFullYear() + p(d.getMonth() + 1) + p(d.getDate()); }
function downloadCsv() {
  if (!S) return;
  const blob = new Blob([csvText()], { type: 'text/csv' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = '採用薬_' + fileStamp() + '.csv';
  document.body.appendChild(a); a.click(); a.remove();
  toast('ダウンロードしました（' + S.list.length + '件）');
}
function exportDrive() {
  call('admExportCsv').then(r => {
    document.getElementById('dlResult').innerHTML = '<div class="note">💾 Googleドライブに保存しました：<a href="' + esc(r.url) + '" target="_blank">' + esc(r.name) + '</a></div>';
  });
}

// ---------- 履歴・ロールバック ----------
function renderHistory() {
  document.getElementById('histBody').innerHTML = S.history.map(h =>
    '<tr><td>' + esc(h.date) + '</td><td>' + esc(h.op) + '</td><td>' + esc(h.before) + ' → ' + esc(h.after) + '</td><td>' + esc(h.detail) + '</td><td class="muted">' + esc(h.who) + '</td></tr>').join('') ||
    '<tr><td colspan="5" class="muted">まだ履歴はありません</td></tr>';
}
function renderBackups() {
  document.getElementById('genInfo').textContent = '（最大 ' + S.generations + ' 世代）';
  document.getElementById('bkBody').innerHTML = S.backups.map(b =>
    '<tr><td>' + esc(b.label) + '</td><td>' + b.count + ' 件</td><td><button class="btn ghost sm" onclick="restore(\'' + esc(b.name) + '\',\'' + esc(b.label) + '\',' + b.count + ')">この状態に戻す</button></td></tr>').join('') ||
    '<tr><td colspan="3" class="muted">まだバックアップはありません（最初の更新で作られます）</td></tr>';
}
function restore(name, label, count) {
  if (!confirm(label + ' の状態（' + count + '件）に戻します。よろしいですか？')) return;
  call('admRestore', name).then(apply);
}

// ---------- 起動 ----------
TOKEN = loadToken();
if (TOKEN) { document.getElementById('login').classList.add('hidden'); reload(); }
else showLogin('');
</script>
