function closeFix() { document.getElementById('fix').classList.add('hidden'); FIX = null; }
function doReplace(newCode, name, spec, label) {
  const t = FIX.target;
  const over = document.getElementById('fixOverwrite').checked;
  const msg = '「' + t.name + '」のYJコードを\n' + t.code + ' → ' + newCode + '（' + label + '）\nに変更します。' +
    (over ? '\n薬品名・規格も医薬品一覧の内容に置き換えます。' : '\n薬品名・規格・メモはそのままです。') + '\nよろしいですか？';
  if (!confirm(msg)) return;
  call('admReplaceCode', t.code, over ? { code: newCode, name, spec } : { code: newCode }).then(st => { closeFix(); apply(st); });
}
function fixPick(i) {
  const c = FIX.candidates[i];
  doReplace(c.code, c.name, c.spec, c.name + (c.maker ? '／' + c.maker : ''));
}
let fixLast = '';
function fixLookup() {
  const code = norm(document.getElementById('fixCode').value);
  document.getElementById('fixCode').value = code;
  const out = document.getElementById('fixLookupInfo');
  if (!code) { out.textContent = ''; return; }
  if (!YJ.test(code)) { out.textContent = '⚠️ 12桁のYJコードを入れてください'; return; }
  if (code === fixLast) return;
  fixLast = code;
  call('admLookup', code).then(r => {
    out.textContent = !r.ok ? '🤔 ' + r.message : r.exact ? '✅ ' + r.name + '（' + r.spec + (r.maker ? '／' + r.maker : '') + '）' : '🟡 銘柄は一覧にありません（同規格：' + r.name + '）';
    out.dataset.name = r.ok && r.exact ? r.name : ''; out.dataset.spec = r.ok && r.exact ? r.spec : '';
  });
}
function fixManual() {
  const code = norm(document.getElementById('fixCode').value);
  if (!YJ.test(code)) { toast('12桁のYJコードを入れてください', true); return; }
  const out = document.getElementById('fixLookupInfo');
  doReplace(code, out.dataset.name || '', out.dataset.spec || '', out.dataset.name || '直接入力');
}

