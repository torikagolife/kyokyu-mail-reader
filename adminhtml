<!DOCTYPE html>
<html lang="ja">
<head>
<base target="_top">
<meta charset="utf-8">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --teal:#12a39a; --teal-d:#0d7d76; --teal-l:#e6f6f4;
    --coral:#f26b5b; --coral-l:#ffecE9; --sun:#ffb830; --sun-l:#fff6d6;
    --ink:#1f2d3d; --sub:#5d6b78; --line:#e3e8ea; --bg:#f4f8f8; --white:#fff;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:"Hiragino Sans","Meiryo UI",Meiryo,sans-serif;font-size:14px}
  header{background:var(--teal);color:#fff;padding:14px 20px;display:flex;align-items:center;gap:12px}
  header h1{margin:0;font-size:19px}
  header .sheet{font-size:12px;opacity:.85}
  main{padding:16px 20px 40px;max-width:1080px;margin:0 auto}
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:14px}
  .stat{background:var(--white);border:1px solid var(--line);border-radius:12px;padding:12px 16px}
  .stat .k{font-size:12px;color:var(--sub)}
  .stat .v{font-size:28px;font-weight:700;color:var(--teal-d);line-height:1.3}
  .stat .v small{font-size:14px}
  .stat .s{font-size:12px;color:var(--sub)}
  details.card{background:var(--white);border:1px solid var(--line);border-radius:12px;margin-bottom:12px;overflow:hidden}
  details.card>summary{list-style:none;cursor:pointer;padding:12px 16px;font-weight:700;font-size:15px;display:flex;align-items:center;gap:8px}
  details.card>summary::-webkit-details-marker{display:none}
  details.card>summary::after{content:"▸";margin-left:auto;color:var(--sub);transition:transform .15s}
  details.card[open]>summary::after{transform:rotate(90deg)}
  details.card[open]>summary{border-bottom:1px solid var(--line)}
  .body{padding:14px 16px}
  .row{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin-bottom:10px}
  label.f{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--sub)}
  input[type=text],select{border:1px solid #c9d3d6;border-radius:8px;padding:7px 10px;font-size:14px;font-family:inherit;background:#fff}
  input[type=text]:focus,select:focus{outline:2px solid var(--teal);border-color:var(--teal)}
  .btn{border:0;border-radius:8px;padding:8px 16px;font-size:14px;font-family:inherit;cursor:pointer;background:var(--teal);color:#fff;font-weight:700}
  .btn:hover{background:var(--teal-d)}
  .btn.ghost{background:#fff;color:var(--teal-d);border:1px solid var(--teal)}
  .btn.danger{background:var(--coral)}
  .btn.sm{padding:4px 10px;font-size:12px;white-space:nowrap}
  .btn:disabled{opacity:.5;cursor:default}
  table{border-collapse:collapse;width:100%}
  th,td{border-bottom:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:top;font-size:13px}
  th{background:#fbfdfd;color:var(--sub);font-weight:700;position:sticky;top:0}
  .scroll{max-height:420px;overflow:auto;border:1px solid var(--line);border-radius:8px}
  .mono{font-family:Consolas,"Courier New",monospace}
  .chip{display:inline-block;border-radius:10px;padding:0 8px;font-size:11px;font-weight:700;white-space:nowrap}
  .chip.exact{background:var(--teal-l);color:var(--teal-d)}
  .chip.near{background:var(--sun-l);color:#a96d00}
  .chip.none{background:var(--coral-l);color:#c0392b}
  .hint{font-size:12px;color:var(--sub);margin:4px 0 0}
  .muted{color:var(--sub)}
  .note{background:var(--sun-l);border:1px solid #ffd56a;border-radius:8px;padding:8px 12px;font-size:13px;margin:8px 0}
  .warn{background:var(--coral-l);border:1px solid #f7a79e;border-radius:8px;padding:8px 12px;font-size:13px;margin:8px 0}
  #toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:20px;font-size:14px;opacity:0;transition:opacity .2s;pointer-events:none;z-index:20;max-width:90%}
  #toast.show{opacity:.95}
  #toast.err{background:#c0392b}
  #busy{position:fixed;inset:0;background:rgba(255,255,255,.55);display:none;align-items:center;justify-content:center;z-index:15;font-weight:700;color:var(--teal-d)}
  #busy.show{display:flex}
  .colsel td.pick{background:var(--teal-l)}
  .radio{display:flex;gap:16px;font-size:13px}
  #login{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:12}
  #login .box{background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px 32px;width:360px;box-shadow:0 8px 24px rgba(0,0,0,.06);text-align:center}
  #login h2{margin:6px 0 4px;font-size:18px}
  #login input[type=password]{width:100%;margin:16px 0 10px;font-size:16px;padding:10px 12px;border:1px solid #c9d3d6;border-radius:8px}
  #login .err{color:#c0392b;font-size:13px;min-height:1.4em;margin-top:8px}
  .hidden{display:none !important}
  .search-box{background:var(--teal-l);border-radius:10px;padding:10px 12px;margin-bottom:12px}
  .search-box .scroll{background:#fff}
  .divider{display:flex;align-items:center;gap:10px;color:var(--sub);font-size:12px;margin:4px 0 12px}
  .divider::before,.divider::after{content:"";flex:1;border-top:1px dashed #c9d3d6}
  .sub2{font-size:11px;color:var(--sub)}
  .chip.adopted{background:#e8eaf6;color:#3949ab}
  .chip.kind{background:#f1f4f6;color:var(--sub)}
  tr.picked td{background:var(--sun-l)}
  .linkish{color:var(--teal-d);text-decoration:underline;cursor:pointer;font-weight:700}
  #fix{position:fixed;inset:0;background:rgba(31,45,61,.45);display:flex;align-items:flex-start;justify-content:center;z-index:13;padding:30px 16px;overflow:auto}
  #fix .panel{background:#fff;border-radius:14px;width:100%;max-width:980px;padding:18px 20px;box-shadow:0 10px 30px rgba(0,0,0,.2)}
  #fix h3{margin:0 0 10px;font-size:17px}
  .target{background:var(--bg);border-radius:10px;padding:10px 14px;margin-bottom:12px;font-size:13px}
  .chip.reason9{background:var(--sun-l);color:#a96d00}
  .chip.reason7{background:#e7f0fe;color:#1a56b8}
  .chip.reasonN{background:#f1f4f6;color:var(--sub)}
  tr.samespec td:first-child{border-left:4px solid var(--teal)}
</style>
</head>
<body>
<header>
  <div style="font-size:26px">🛰️</div>
  <div>
    <h1>供給メールレーダー　採用薬の管理</h1>
    <div class="sheet" id="sheetName"></div>
  </div>
  <div style="margin-left:auto;display:flex;gap:8px">
    <button class="btn ghost sm" style="background:#fff" onclick="reload()">🔄 再読み込み</button>
    <button class="btn ghost sm" style="background:#fff" onclick="logout()">🚪 ログアウト</button>
  </div>
</header>

<main>
  <!-- 件数 -->
  <div class="stats">
    <div class="stat"><div class="k">💊 採用薬</div><div class="v" id="stCount">-</div><div class="s" id="stCountSub">&nbsp;</div></div>
    <div class="stat"><div class="k">📖 医薬品一覧との照合</div><div class="v" id="stMatch">-</div><div class="s" id="stMatchSub">&nbsp;</div></div>
    <div class="stat"><div class="k">🕒 最終更新</div><div class="v" id="stLast" style="font-size:18px;padding-top:6px">-</div><div class="s">この画面からの更新</div></div>
  </div>

  <!-- 一覧 -->
  <details class="card" id="cardList">
    <summary>📋 採用薬一覧 <span class="muted" id="listCount" style="font-weight:400;font-size:13px"></span></summary>
    <div class="body">
      <div class="row">
        <label class="f" style="flex:1">🔍 検索（YJコード・薬品名・規格・メモ）
          <input type="text" id="q" placeholder="例：アムロジピン、2171022" oninput="renderList()">
        </label>
        <label class="f">照合状況
          <select id="fSt" onchange="renderList()">
            <option value="">すべて</option>
            <option value="exact">一覧と一致</option>
            <option value="near">上9桁のみ一致</option>
            <option value="none">一覧に該当なし</option>
          </select>
        </label>
      </div>
      <div class="scroll">
        <table>
          <thead><tr><th style="width:120px">YJコード</th><th>薬品名</th><th style="width:140px">規格</th><th>メモ</th><th style="width:90px">照合</th><th style="width:190px"></th></tr></thead>
          <tbody id="listBody"></tbody>
        </table>
      </div>
      <div class="hint" id="listMore"></div>
    </div>
  </details>

  <!-- 個別追加 -->
  <details class="card">
    <summary>➕ 採用薬を1件追加</summary>
    <div class="body">
      <div class="search-box">
        <div class="row" style="margin-bottom:6px">
          <label class="f" style="flex:1">🔍 医薬品一覧から探す（品名・成分名・メーカー・規格・YJコード。スペースで区切ると絞り込み）
            <input type="text" id="mq" placeholder="例：アムロジピン 5mg ／ あむろ 沢井" onkeydown="if(event.key==='Enter')searchMaster()">
          </label>
          <button class="btn" onclick="searchMaster()">検索</button>
        </div>
        <div class="hint" id="mInfo"></div>
        <div class="scroll" id="mWrap" style="max-height:300px;margin-top:6px;display:none">
          <table>
            <thead><tr><th>品名</th><th style="width:130px">規格</th><th style="width:150px">メーカー</th><th style="width:110px">YJコード</th><th style="width:150px"></th></tr></thead>
            <tbody id="mBody"></tbody>
          </table>
        </div>
      </div>
      <div class="divider"><span>または YJコードを直接入力</span></div>
      <div class="row">
        <label class="f">YJコード（12桁）<input type="text" id="aCode" class="mono" style="width:160px" placeholder="1169017F1025" onblur="lookup()"></label>
        <button class="btn ghost sm" onclick="lookup(true)">📖 医薬品一覧から入力</button>
        <span class="hint" id="aLookup"></span>
      </div>
      <div class="row">
        <label class="f" style="flex:2">薬品名<input type="text" id="aName"></label>
        <label class="f" style="flex:1">規格<input type="text" id="aSpec"></label>
      </div>
      <div class="row">
        <label class="f" style="flex:1">メモ（加工メールに表示されます・空欄OK）<input type="text" id="aMemo" placeholder="例：粉砕不可"></label>
        <button class="btn" onclick="addOne()">追加する</button>
      </div>
      <p class="hint">💡 検索結果の「選ぶ」で下の欄に入るので、薬品名を院内の名前に直してから追加できます。「すぐ追加」は医薬品一覧の品名のまま追加します。</p>
    </div>
  </details>

  <!-- 採用薬一括アップロード -->
  <details class="card">
    <summary>📤 採用薬一括アップロード（CSV・Excel）</summary>
    <div class="body">
      <div class="row">
        <label class="f">ファイル（.csv / .xlsx / .xls）<input type="file" id="upFile" accept=".csv,.txt,.xlsx,.xls" onchange="readFile()"></label>
        <label class="f">文字コード（CSVのみ）
          <select id="upEnc" onchange="readFile()">
            <option value="auto">自動判定</option>
            <option value="utf-8">UTF-8</option>
            <option value="shift_jis">Shift_JIS</option>
          </select>
        </label>
        <label class="f" style="flex-direction:row;align-items:center;gap:6px;color:var(--ink)"><input type="checkbox" id="upHeader" checked onchange="renderPreview()">1行目は見出し</label>
      </div>
      <div id="upArea" style="display:none">
        <div class="row" id="sheetPick" style="display:none">
          <label class="f">シート<select id="upSheet" onchange="pickSheet()"></select></label>
        </div>
        <div class="row">
          <label class="f">🔢 YJコードの列<select id="cCode" onchange="renderPreview()"></select></label>
          <label class="f">💊 薬品名の列<select id="cName" onchange="renderPreview()"></select></label>
          <label class="f">📏 規格の列<select id="cSpec" onchange="renderPreview()"></select></label>
          <label class="f">📝 メモの列<select id="cMemo" onchange="renderPreview()"></select></label>
        </div>
        <div class="hint" id="upStat"></div>
        <div class="scroll" style="max-height:220px;margin:8px 0"><table class="colsel"><tbody id="upPrev"></tbody></table></div>
        <div class="radio">
          <label><input type="radio" name="upMode" value="replace" checked> 🔁 置換（今の採用薬をすべて入れ替える）</label>
          <label><input type="radio" name="upMode" value="append"> ➕ 追加（登録済みのコードはスキップ）</label>
        </div>
        <div class="row" style="margin-top:10px"><button class="btn" id="upBtn" onclick="upload()">アップロードする</button></div>
        <div class="note">💾 アップロード前の採用薬は自動でバックアップされます。間違えたときは「⏪ ロールバック」で戻せます。</div>
      </div>
      <div id="upResult"></div>
    </div>
  </details>

  <!-- 一括ダウンロード -->
  <details class="card">
    <summary>📥 一括ダウンロード</summary>
    <div class="body">
      <div class="row">
        <button class="btn" onclick="downloadCsv()">CSVをダウンロード</button>
        <button class="btn ghost" onclick="exportDrive()">Googleドライブに保存</button>
      </div>
      <p class="hint">CSVはExcelで開いても文字化けしない形式（UTF-8 BOM付き）です。ダウンロードできないときは「Googleドライブに保存」を使ってください。</p>
      <div id="dlResult"></div>
    </div>
  </details>

  <!-- 医薬品一覧アップロード -->
  <details class="card">
    <summary>📚 医薬品一覧アップロード <span class="muted" id="mstInfo" style="font-weight:400;font-size:13px"></span></summary>
    <div class="body">
      <p style="margin-top:0">DSJPのメールの品名からYJコードを調べる「医薬品一覧」を、厚生労働省の<b>薬価基準収載品目リスト</b>で更新します。</p>
      <ol style="margin:0 0 10px;padding-left:20px;line-height:1.8">
        <li>厚生労働省のページ
          <a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/0000078916.html" target="_blank" rel="noopener">🔗 医療保険が適用される医薬品について｜厚生労働省</a>
          を開く</li>
        <li>「薬価基準収載品目リストについて」の最新の日付のページを開く</li>
        <li><b>内用薬（_01）・注射薬（_02）・外用薬（_03）</b>のExcelをダウンロードする（歯科用薬剤（_04）は任意）</li>
        <li>下の「ファイル」で、ダウンロードしたファイルを<b>まとめて選ぶ</b>（Ctrlを押しながらクリック）</li>
      </ol>
      <div class="note">📝 ファイル名は <span class="mono">tp20261014-01_01.xlsx</span> のような形です。区分ごとに日付が違うことがありますが、そのまま選んでOKです。「その他（_05）」「除外品目（_06）」は形式が違うので使いません。</div>
      <div class="row">
        <label class="f">ファイル（.xlsx・複数選択可）<input type="file" id="mstFile" accept=".xlsx,.xls" multiple onchange="readMasterFiles()"></label>
      </div>
      <div id="mstArea" style="display:none">
        <table style="margin-bottom:10px">
          <thead><tr><th>ファイル</th><th style="width:110px">種類</th><th style="width:110px">件数</th><th>状態</th></tr></thead>
          <tbody id="mstFiles"></tbody>
        </table>
        <div class="hint" id="mstWarn"></div>
        <div class="radio" style="margin-top:8px">
          <label><input type="radio" name="mstMode" value="merge" checked> 🔁 追記・更新（おすすめ：今の一覧にしかない古い品目も残す）</label>
          <label><input type="radio" name="mstMode" value="replace"> 🧹 置き換え（今の一覧を消して入れ直す）</label>
        </div>
        <div class="row" style="margin-top:10px"><button class="btn" id="mstBtn" onclick="uploadMaster()">医薬品一覧を取り込む</button></div>
        <p class="hint">💡 経過措置が切れて新しいリストから消えた品目も、販売中止の通知が後から届くことがあります。ふだんは「追記・更新」を使ってください。取り込みには数十秒かかることがあります。</p>
      </div>
      <div id="mstResult"></div>
      <div id="mstRestore"></div>
    </div>
  </details>

  <!-- 更新履歴 -->
  <details class="card">
    <summary>🕒 更新履歴 <span class="muted" style="font-weight:400;font-size:13px">（直近50件）</span></summary>
    <div class="body">
      <div class="scroll" style="max-height:320px">
        <table>
          <thead><tr><th style="width:150px">日時</th><th style="width:90px">操作</th><th style="width:90px">件数</th><th>内容</th><th style="width:170px">実行者</th></tr></thead>
          <tbody id="histBody"></tbody>
        </table>
      </div>
    </div>
  </details>

  <!-- ロールバック -->
  <details class="card">
    <summary>⏪ ロールバック <span class="muted" id="genInfo" style="font-weight:400;font-size:13px"></span></summary>
    <div class="body">
      <p class="hint" style="margin-top:0">採用薬を更新するたびに、更新直前の状態を別シート（非表示）に保存しています。戻したい時点を選んでください。</p>
      <table>
        <thead><tr><th>保存日時（この時刻の直前の状態）</th><th style="width:100px">件数</th><th style="width:160px"></th></tr></thead>
        <tbody id="bkBody"></tbody>
      </table>
      <div class="warn">⚠️ 戻すと、今の採用薬もバックアップに残ります（いちばん古いバックアップが消えます）。</div>
    </div>
  </details>
</main>

<div id="login">
  <div class="box">
    <div style="font-size:40px">🛰️</div>
    <h2>供給メールレーダー</h2>
    <div class="muted" style="font-size:13px">採用薬の管理画面</div>
    <input type="password" id="pw" placeholder="パスワード" autocomplete="current-password" onkeydown="if(event.key==='Enter')login()">
    <label style="display:flex;align-items:center;gap:6px;justify-content:center;font-size:13px;margin-bottom:14px">
      <input type="checkbox" id="remember" checked> このブラウザにログイン状態を保存する
    </label>
    <button class="btn" style="width:100%" onclick="login()">ログイン</button>
    <div class="err" id="loginErr"></div>
    <p class="hint">共用のパソコンでは保存のチェックを外してください。</p>
  </div>
</div>

<div id="fix" class="hidden">
  <div class="panel">
    <div style="display:flex;align-items:center;gap:10px">
      <h3>🔧 YJコードの修正</h3>
      <button class="btn ghost sm" style="margin-left:auto" onclick="closeFix()">✕ 閉じる</button>
    </div>
    <div class="target" id="fixTarget"></div>
    <div class="hint" id="fixInfo" style="margin-bottom:6px"></div>
    <label style="display:flex;align-items:center;gap:6px;font-size:13px;margin:4px 0 8px">
      <input type="checkbox" id="fixOverwrite"> 薬品名・規格も医薬品一覧の内容に置き換える（チェックなし：院内の薬品名・規格・メモはそのまま）
    </label>
    <div class="scroll" style="max-height:360px">
      <table>
        <thead><tr><th style="width:130px">候補の理由</th><th>品名</th><th style="width:120px">規格</th><th style="width:130px">メーカー</th><th style="width:110px">YJコード</th><th style="width:150px"></th></tr></thead>
        <tbody id="fixBody"></tbody>
      </table>
    </div>
    <div class="divider" style="margin-top:14px"><span>候補にないときは YJコードを直接入力</span></div>
    <div class="row">
      <label class="f">新しいYJコード（12桁）<input type="text" id="fixCode" class="mono" style="width:170px" onblur="fixLookup()"></label>
      <span class="hint" id="fixLookupInfo" style="flex:1"></span>
      <button class="btn" onclick="fixManual()">このコードにする</button>
    </div>
    <p class="hint">💡 左に緑の線がある候補は、規格が今の登録と同じものです。修正前の状態は自動でバックアップされるので、「⏪ ロールバック」で戻せます。</p>
  </div>
</div>

<div id="busy">⏳ 処理中…</div>
<div id="toast"></div>

<script>
let S = null;          // サーバーからの状態
let LIMIT = 300;       // 一覧の表示件数
let UP = { sheets: null, rows: [], name: '' };

// ---------- 共通 ----------
// ---------- ログイン ----------
const TOKEN_KEY = 'dsjpRadarAdminToken';
let TOKEN = '';
function store() { try { return window.localStorage; } catch (e) { return null; } }
function loadToken() { try { return (store() && store().getItem(TOKEN_KEY)) || ''; } catch (e) { return ''; } }
function saveToken(t) { try { store() && store().setItem(TOKEN_KEY, t); } catch (e) {} }
function clearToken() { try { store() && store().removeItem(TOKEN_KEY); } catch (e) {} }
function showLogin(msg, info) {
  TOKEN = ''; S = null;
  document.getElementById('login').classList.remove('hidden');
  const el = document.getElementById('loginErr');
  el.textContent = msg || '';
  el.style.color = info ? 'var(--teal-d)' : '';
  document.getElementById('pw').value = '';
  setTimeout(() => document.getElementById('pw').focus(), 50);
}
function login() {
  const pw = document.getElementById('pw').value;
  if (!pw) { document.getElementById('loginErr').textContent = 'パスワードを入れてください'; return; }
  busy(true);
  google.script.run
    .withSuccessHandler(r => {
      busy(false);
      TOKEN = r.token;
      if (document.getElementById('remember').checked) saveToken(TOKEN); else clearToken();
      document.getElementById('login').classList.add('hidden');
      reload();
    })
    .withFailureHandler(e => { busy(false); const el = document.getElementById('loginErr'); el.style.color = ''; el.textContent = e.message || String(e); })
    .admLogin(pw);
}
function logout() {
  if (!confirm('ログアウトします。このブラウザに保存したログイン状態も消えます。')) return;
  clearToken();
  showLogin('👋 ログアウトしました', true);
}

// ---------- 通信 ----------
function call(fn, ...args) {
  return new Promise(res => {
    busy(true);
    google.script.run
      .withSuccessHandler(v => { busy(false); res(v); })
      .withFailureHandler(e => {
        busy(false);
        const m = (e && e.message) || String(e);
        if (m.indexOf('AUTH:') >= 0) { clearToken(); showLogin('もう一度ログインしてください（パスワードが変更された可能性があります）'); }
        else toast(m, true);
        // エラー時は呼び出し元の処理を進めない（rejectしない）
      })[fn](TOKEN, ...args);
  });
}
// ---------- 共通 ----------
function busy(on) { document.getElementById('busy').classList.toggle('show', on); }
let toastTimer;
function toast(m, err) {
  const t = document.getElementById('toast');
  t.textContent = m; t.className = 'show' + (err ? ' err' : '');
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.className = '', err ? 6000 : 3000);
}
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
function norm(s) { return String(s == null ? '' : s).normalize('NFKC').replace(/\s/g, '').toUpperCase(); }
function colName(i) { let s = ''; i++; while (i > 0) { const m = (i - 1) % 26; s = String.fromCharCode(65 + m) + s; i = Math.floor((i - 1) / 26); } return s; }
const YJ = /^[0-9]{7}[A-Z][0-9A-Z]{4}$/;

// ---------- 状態 ----------
function apply(st) {
  S = st;
  if (st.message) toast(st.message);
  document.getElementById('sheetName').textContent = st.sheetName || '';
  document.getElementById('stCount').innerHTML = st.count + '<small> 件</small>';
  if (st.match) {
    const pct = st.count ? Math.round(st.match.exact / st.count * 100) : 0;
    document.getElementById('stMatch').innerHTML = pct + '<small> %</small>';
    const lk = (k, label, n) => n ? '<span class="linkish" onclick="jumpList(\'' + k + '\')">' + label + ' ' + n + '</span>' : label + ' 0';
    document.getElementById('stMatchSub').innerHTML = '一致 ' + st.match.exact + '／' + lk('near', '上9桁', st.match.near) + '／' + lk('none', '該当なし', st.match.none) +
      (st.match.near + st.match.none ? '<br><span style="font-size:11px">👆 数字を押すと一覧で確認・修正できます</span>' : '');
  } else {
    document.getElementById('stMatch').textContent = '—';
    document.getElementById('stMatchSub').textContent = st.masterError || '';
  }
  document.getElementById('stLast').textContent = st.lastUpdate || '—';
  renderList(); renderHistory(); renderBackups(); renderMasterInfo();
}
function reload() { call('admGetState').then(apply); }

